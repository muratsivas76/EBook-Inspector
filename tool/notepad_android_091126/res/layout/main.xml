<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:fitsSystemWindows="true">

        <!-- Search Toolbar: Hidden by default (Untouched) -->
        <LinearLayout
            android:id="@+id/search_toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="#EEEEEE"
            android:padding="4dp"
            android:visibility="gone"
            android:gravity="center_vertical">

            <Button
                android:id="@+id/btn_close_search"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="X"
                android:textColor="#FF0000"
                android:textStyle="bold"
                android:minWidth="50dp"/>

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/search_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingRight="8dp"
                android:text="Find..."
                android:textSize="14sp"
                android:textColor="#007BFF"
                android:textStyle="bold"
                android:gravity="end"/>

            <Button
                android:id="@+id/btn_prev"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="&lt;"
                android:textSize="14sp"
                android:minWidth="50dp"
                android:textStyle="bold"
                android:textColor="#007BFF"/>

            <Button
                android:id="@+id/btn_next"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="&gt;"
                android:textSize="14sp"
                android:minWidth="50dp"
                android:textStyle="bold"
                android:textColor="#007BFF"/>
        </LinearLayout>

        <!-- 
          NEW: Chunk Navigation Control Panel. 
          Features dynamic total chunk index formatting and an intuitive mini jump dialog box.
        -->
        <LinearLayout
            android:id="@+id/chunk_navigation_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="#DDDDDD"
            android:padding="6dp"
            android:visibility="gone"
            android:gravity="center_vertical">

            <Button
                android:id="@+id/btn_chunk_prev"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="&lt;&lt; Prev"
                android:textSize="12sp"
                android:textStyle="bold"
                android:minWidth="80dp" />

            <!-- Displays the human-readable total metrics (e.g., Chunk: 1 / 5) -->
            <TextView
                android:id="@+id/tv_chunk_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Chunk: 1/1"
                android:layout_marginStart="8dp"
                android:textSize="13sp"
                android:textColor="#333333"
                android:textStyle="bold" />

            <!-- Mini layout input field tracking allowing direct single-pass zipping jumps -->
            <EditText
                android:id="@+id/et_chunk_jump"
                android:layout_width="50dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="6dp"
                android:background="#FFFFFF"
                android:gravity="center"
                android:inputType="number"
                android:text="0"
                android:textSize="12sp"
                android:textStyle="bold"
                android:padding="4dp" />

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <Button
                android:id="@+id/btn_chunk_next"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Next &gt;&gt;"
                android:textSize="12sp"
                android:textStyle="bold"
                android:minWidth="80dp" />
        </LinearLayout>
		
        <net.murat.uikit.MEditor
            android:id="@+id/editor"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="top|start"
            android:background="@null"
            android:padding="10dp"
            android:hint="@string/hint_github"
            android:inputType="textMultiLine|textAutoCorrect"
            android:typeface="monospace"
            android:textSize="24sp" 
            android:scrollbars="vertical"
            android:fadeScrollbars="false"
            android:scrollbarSize="5dp" 
            android:hyphenationFrequency="none"
            android:breakStrategy="simple"
            android:scrollbarStyle="insideOverlay" />
    </LinearLayout>

    <!-- 
      Loading Overlay: Prevents interaction during 3MB+ file loading/saving.
    -->
    <FrameLayout
        android:id="@+id/loading_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#44000000"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true"
        android:fitsSystemWindows="true">

        <ProgressBar
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center" />
    </FrameLayout>

</FrameLayout>
